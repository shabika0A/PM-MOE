import numpy as np
import os
import glob
import torch
from torch.utils.data import Dataset

def _pick_key(available, candidates):
    lower = {k.lower(): k for k in available}
    for c in candidates:
        k = lower.get(c.lower())
        if k is not None:
            return k
    return None

def _resolve_npz_path(dataset, idx, is_train):
    """
    Robust resolver: search recursively for a file that matches the client idx and split.
    Works with many filename styles:
      - {dataset}_client_{idx}_{split}.npz
      - client_{idx}_{split}.npz
      - {split}/client_{idx}.npz
      - user_{idx}_{split}.npz
      - {split}/{idx}.npz
      - generic shards like *{split}*{idx}*.npz or *client*{idx}*{split}*.npz
    """
    split = 'train' if is_train else 'test'
    base_dir = os.path.abspath(os.path.join(os.path.dirname(__file__), '..', '..', 'dataset', dataset))

    # Priority patterns (more specific first)
    patterns = [
        f"{dataset}_client_{idx}_{split}.npz",
        f"client_{idx}_{split}.npz",
        os.path.join(split, f"client_{idx}.npz"),
        f"user_{idx}_{split}.npz",
        os.path.join(split, f"user_{idx}.npz"),
        f"{split}_{dataset}_client_{idx}.npz",
        f"{split}_{idx}.npz",
        os.path.join(split, f"{idx}.npz"),
        # Generic fallbacks
        f"*client*{idx}*{split}*.npz",
        f"*{split}*client*{idx}*.npz",
        f"*user*{idx}*{split}*.npz",
        f"*{split}*{idx}*.npz",
        f"*{idx}*{split}*.npz",
    ]

    matches = []
    for pat in patterns:
        g = glob.glob(os.path.join(base_dir, "**", pat), recursive=True)
        if g:
            matches.extend(g)

    if not matches:
        # Show the caller what exists to help debug
        all_npz = glob.glob(os.path.join(base_dir, "**", "*.npz"), recursive=True)
        raise FileNotFoundError(
            f"NPZ missing for dataset={dataset}, idx={idx}, split={split}.\n"
            f"Searched under: {base_dir}\n"
            f"Patterns tried: {patterns}\n"
            f"Found NPZ files: {all_npz[:50]}{' ... (truncated)' if len(all_npz) > 50 else ''}"
        )

    # Prefer paths that explicitly include 'client_{idx}' or '{split}' and are shortest
    def _score(p):
        name = p.replace(os.sep, '/').lower()
        s = 0
        if f"client_{idx}" in name: s -= 10
        if f"user_{idx}" in name:   s -= 9
        if f"/{split}/" in name or name.endswith(f"_{split}.npz"): s -= 5
        s += len(name)  # shorter is better
        return s

    matches.sort(key=_score)
    return matches[0]

def read_data(dataset, idx, is_train):
    """
    Robust NPZ reader:
      * resolves file path via recursive globbing
      * supports multiple key conventions
      * returns normalized dict: {'x': ..., 'y': ...}
    """
    fpath = _resolve_npz_path(dataset, idx, is_train)
    npz = np.load(fpath, allow_pickle=True)
    keys = list(npz.keys())

    data_key  = _pick_key(keys, ['data', 'x', 'images', 'inputs', 'features'])
    label_key = _pick_key(keys, ['label', 'labels', 'y', 'targets', 'target'])
    if data_key is None or label_key is None:
        raise KeyError(
            f"File '{fpath}' has keys {keys}, expected one of "
            f"[data|x|images|inputs|features] & [label|labels|y|targets|target]"
        )

    X, y = npz[data_key], npz[label_key]
    return {
        'x': X.tolist() if isinstance(X, np.ndarray) else list(X),
        'y': y.tolist() if isinstance(y, np.ndarray) else list(y)
    }

class PairListDataset(Dataset):
    """
    Returns ([x_tensor], y_tensor) for each index so existing code that does:
        for x, y in loader: x[0] = x[0].to(device)
    will work (x is a list whose first element is a Tensor).
    """
    def __init__(self, X, Y):
        assert len(X) == len(Y), f"Length mismatch: {len(X)} vs {len(Y)}"
        self.X = X
        self.Y = Y

    def __len__(self):
        return len(self.X)

    def __getitem__(self, i):
        xi = self.X[i]
        yi = self.Y[i]

        if not isinstance(xi, np.ndarray):
            xi = np.array(xi)

        # HWC -> CHW if needed
        if xi.ndim == 3 and xi.shape[-1] in (1, 3):
            xi = np.transpose(xi, (2, 0, 1))
        elif xi.ndim == 2:
            xi = xi[None, :, :]

        x_t = torch.from_numpy(xi).float()
        if x_t.max() > 1.0:
            x_t = x_t / 255.0

        try:
            y_t = torch.tensor(int(yi), dtype=torch.long)
        except Exception:
            y_t = torch.as_tensor(yi, dtype=torch.long)

        # ⬅️ IMPORTANT: return a Tensor, not [Tensor]
        return x_t, y_t


def read_client_data(dataset, idx, is_train=True):
    """
    Make the DataLoader happy:
      - read NPZ (your robust read_data)
      - return a Dataset that yields ([x_tensor], y_tensor)
    """
    out = read_data(dataset, idx, is_train)

    # Accept both normalized {'x','y'} and legacy variants
    if isinstance(out, dict):
        kx = next((k for k in ('x','data','images','inputs','features') if k in out), None)
        ky = next((k for k in ('y','label','labels','targets','target') if k in out), None)
        if kx is None or ky is None:
            raise KeyError(f"read_client_data: could not find x/y in keys {list(out.keys())}")
        X, Y = out[kx], out[ky]
    else:
        try:
            X, Y = out
        except Exception as e:
            raise TypeError(f"read_client_data expected dict or (X,Y), got {type(out)}") from e

    return PairListDataset(X, Y)

